{
  "name": "home-recipes",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Home Recipes: Firebase cloud sync, password authentication, Cloudinary images, routeable recipe pages and an optional local JSON server.",
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "concurrently -k -n API,WEB -c auto \"npm:dev:server\" \"npm:dev:web:local\"",
    "dev:cloud": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "dev:web:local": "vite --host 0.0.0.0 --mode lan",
    "build": "npm run build:cloud",
    "build:cloud": "vite build --mode production",
    "build:local": "vite build --mode lan",
    "start": "node server/index.js",
    "lan": "npm run build:local && npm start",
    "test": "node --test tests/*.test.js",
    "sync:fineli": "node scripts/sync-fineli-recipes.js",
    "sync:fineli:fresh": "node scripts/sync-fineli-recipes.js --refresh",
    "deploy:firebase": "npm run build:cloud && firebase deploy"
  },
  "dependencies": {
    "compression": "1.8.1",
    "express": "4.22.2",
    "firebase": "^12.0.0",
    "multer": "1.4.5-lts.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "whatwg-fetch": "3.6.20"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "6.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.2",
    "postcss": "8.5.23",
    "sass": "1.83.4",
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=18.18"
  },
  "browserslist": [
    "Android >= 4.4",
    "Chrome >= 49"
  ]
}
