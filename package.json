{
  "name": "home-recipes",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Home Recipes: Finnish recipe data, live Fineli nutrition sync, retailer links, recipe pricing and a shared grocery cart.",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c auto \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "lan": "npm run build && npm start",
    "test": "node --test tests/*.test.js",
    "sync:fineli": "node scripts/sync-fineli-recipes.js",
    "sync:fineli:fresh": "node scripts/sync-fineli-recipes.js --refresh"
  },
  "dependencies": {
    "compression": "1.7.5",
    "express": "4.21.2",
    "multer": "1.4.5-lts.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "whatwg-fetch": "3.6.20"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "6.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "sass": "1.83.4",
    "vite": "6.1.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.1"
  },
  "engines": {
    "node": ">=18.18"
  },
  "browserslist": [
    "Android >= 4.4",
    "Chrome >= 49"
  ]
}
