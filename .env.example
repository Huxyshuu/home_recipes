# Cloud mode. Copy this file to .env.local and fill in the values from
# Firebase Console > Project settings > Your apps > Web app.
VITE_DATA_BACKEND=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Create exactly one Email/Password user in Firebase Authentication.
# The interface asks only for the password and uses this email internally.
VITE_FIREBASE_SHARED_EMAIL=home-recipes@example.com

# Cloudinary unsigned browser upload configuration.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UNSIGNED_UPLOAD_PRESET=

# Optional. Leave empty to call Fineli directly from the browser.
# Set this to a compatible Home Recipes nutrition proxy if browser CORS blocks Fineli.
VITE_FINELI_PROXY_URL=
